{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "echo 'Frontend ready'",
  "outputDirectory": ".",
  "functions": {
    "backend/server.js": {
      "runtime": "nodejs20.x"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/backend/server.js"
    },
    {
      "source": "/",
      "destination": "/frontend/html/index.html"
    }
  ]
}
